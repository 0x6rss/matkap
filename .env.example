# ===== Matkap Web - environment =====
# Copy this file to ".env" and fill in the values.

# Port the server listens on (default 3000)
PORT=3000
# Local-only bind address. Keep 127.0.0.1 unless Docker needs 0.0.0.0.
HOST=127.0.0.1
# Docker Compose overrides this to allow host-to-container requests while the
# published port remains bound to 127.0.0.1. Leave false for a native launch.
MATKAP_TRUST_LOCAL_PROXY=false

# "production" or "development" (default: development)
NODE_ENV=development

# Session cookie secret. Any long random string. If empty, a random one is
# generated at startup (sessions will not survive a restart).
SESSION_SECRET=

# ---- Database (OPTIONAL) ----
# Without DATABASE_URL, MATKAP runs in memory-only mode.
# With the provided docker compose: postgres://matkap:matkap@localhost:5433/matkap
DATABASE_URL=

# ---- Reverse-engineering MCP hub ----
# Install the packaged MATKAP JADX connector with connectors/jadx/install.ps1.
# MATKAP talks directly to its local read-only endpoint; no Python bridge is needed.
JADX_MCP_URL=http://127.0.0.1:8650
JADX_MCP_TRANSPORT=jadx-rest
JADX_MCP_TOKEN=
# Ghidra and Binary Ninja connectors are not released yet (SOON).
MATKAP_MCP_CONNECT_TIMEOUT_MS=3500
MATKAP_MCP_TOOL_TIMEOUT_MS=45000
MATKAP_MCP_AGENT_MAX_STEPS=6
MATKAP_MCP_AGENT_MAX_CALLS=24
# Maximum number of likely text resources read locally before any AI request.
MATKAP_MCP_PREFLIGHT_MAX_FILES=120
# Run only the local MCP UI without Telegram login, DB, or online feeds.
MATKAP_DISABLE_DATABASE=false
MATKAP_DISABLE_TELEGRAM=false
MATKAP_DISABLE_FEEDS=false

# ---- AI provider for MCP investigation ----
# AI calls are server-side and keys are never returned to the browser. Only MCP
# tool output needed for the investigation is sent; MATKAP never uploads a sample.
MATKAP_AI_ENABLED=true
MATKAP_AI_PRIMARY=anthropic
MATKAP_AI_TIMEOUT_MS=90000

# Configure one or more providers. All models and endpoints are overridable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# KIMI_API_KEY and MOONSHOT_API_KEY are accepted aliases; set only one.
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OrcaRouter - OpenAI-compatible AI gateway (https://www.orcarouter.ai).
# The model list is discovered live from the gateway; pick a model in MCP Lab.
# Get a key at https://www.orcarouter.ai/console/api-keys. It can also be saved
# from the MCP Lab OrcaRouter panel, which writes it to this file.
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=orcarouter/auto
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ---- Telegram controller account(s) ----
# You need at least one Telegram USER account (not a bot) to drive the hunt.
#
# SINGLE ACCOUNT (simplest):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# The phone is only needed for the first local login (NODE_ENV=development).
# MATKAP asks for the Telegram code (and 2FA password, if enabled) in the
# terminal, then writes the generated session to this .env file automatically.
TELEGRAM_PHONE=
# Leave empty on first login. MATKAP fills this value and reuses it on restarts:
TELEGRAM_STRING_SESSION=

# ---- Threat-intel sources (OPTIONAL, for IOC discovery) ----
# Used to search the internet for pages leaking Telegram bot tokens / chat ids.
# urlscan: API key from https://urlscan.io/user/profile ; works on the free tier.
URLSCAN_KEY=
# ZoomEye: API key from your profile at https://www.zoomeye.ai ; body needs
# Business plan (or use "Fetch pages directly" for the free tier).
ZOOMEYE_KEY=
# abuse.ch: free Auth-Key from https://auth.abuse.ch.
# Powers the ThreatFox IOC source (best free token source) AND the MalwareBazaar tab.
ABUSECH_AUTH_KEY=
# Optional: Google Programmable Search (reliable TI dorking, free 100/day).
# Create at https://programmablesearchengine.google.com (set "search entire web").
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# MULTIPLE ACCOUNTS (optional, overrides the single-account fields above):
# A JSON array. Each entry needs apiId, apiHash, stringSession and an optional
# label shown in the UI account selector.
# On the first local start, add each phone and leave stringSession empty. MATKAP
# writes the generated sessions back into this JSON value automatically.
# TELEGRAM_ACCOUNTS=[{"label":"acc1","apiId":"111","apiHash":"aaa","phone":"+15550000001","stringSession":""},{"label":"acc2","apiId":"222","apiHash":"bbb","phone":"+15550000002","stringSession":""}]
TELEGRAM_ACCOUNTS=
